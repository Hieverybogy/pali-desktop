{
  "appId": "com.pali.desktop",
  "productName": "Pali",
  "directories": {
    "output": "outputs"
  },
  "files": [
    "dist/**/*",
    "src/main/**/*.cjs",
    "src/preload/**/*.cjs",
    "src/shared/**/*.json",
    "assets/**/*",
    "package.json"
  ],
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "mac": {
    "extendInfo": { "LSUIElement": true },
    "icon": "assets/dock.png",
    "category": "public.app-category.entertainment",
    "identity": "-",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ]
  },
  "win": {
    "icon": "assets/dock.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
